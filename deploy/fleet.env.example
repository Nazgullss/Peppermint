# Installed to /etc/fleet/fleet.env, owned root:fleet, mode 0640.
#
# provision.sh generates the real file and fills in the two secrets. It lives outside
# /opt/fleet on purpose: the checkout is world-readable and gets replaced on every
# deploy, and credentials should survive a deploy and not be readable by everything on
# the box.
#
# systemd EnvironmentFile format, which is NOT shell: no `export`, no quoting, no
# variable expansion. A value runs to the end of the line.
#
# After editing:  sudo systemctl restart fleet-backend fleet-simulator

# ======================================================================================
# Runtime
# ======================================================================================

# ProtectSystem=strict makes the checkout read-only to the services. Python would
# otherwise try to drop __pycache__ into it on every import.
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# ======================================================================================
# Broker credentials
# ======================================================================================
# The same account for both services. The broker only listens on 127.0.0.1, so this
# password is defence in depth rather than the thing standing between the fleet and the
# internet -- that is the admin token below.

SIM_MQTT_HOST=127.0.0.1
SIM_MQTT_PORT=1883
SIM_MQTT_USERNAME=fleet
SIM_MQTT_PASSWORD=__GENERATED_BY_PROVISION_SH__

BACKEND_MQTT_HOST=127.0.0.1
BACKEND_MQTT_PORT=1883
BACKEND_MQTT_USERNAME=fleet
BACKEND_MQTT_PASSWORD=__GENERATED_BY_PROVISION_SH__

SIM_TOPIC_PREFIX=fleet
BACKEND_TOPIC_PREFIX=fleet

# ======================================================================================
# Simulator: the three knobs under test
# ======================================================================================
# These are the boot defaults only. All four are changeable on the running box without a
# restart via POST /api/admin/config, which is how the load tests are driven.

SIM_FLEET_SIZE=8
SIM_UPDATE_INTERVAL_MS=1000
SIM_PAYLOAD_PADDING_BYTES=0
SIM_PUBLISH_BATCH_SIZE=1

# Fixed so the deployed demo shows the same fleet after every restart.
SIM_SEED=42

# ======================================================================================
# Backend
# ======================================================================================

BACKEND_BROADCAST_HZ=5
BACKEND_SNAPSHOT_EVERY_N_TICKS=50
BACKEND_CLIENT_QUEUE_SIZE=1
BACKEND_STALE_AFTER_SECONDS=10
BACKEND_HISTORY_RETENTION_MINUTES=60

# Guards POST /api/admin/config. Empty disables the live controls outright. provision.sh
# generates one; read it back with:
#   sudo grep BACKEND_ADMIN_TOKEN /etc/fleet/fleet.env
BACKEND_ADMIN_TOKEN=__GENERATED_BY_PROVISION_SH__

# Empty on purpose. The backend serves dashboard/dist from its own origin here, so the
# browser never makes a cross-origin request and there is nothing to allow-list.
BACKEND_CORS_ORIGINS=
