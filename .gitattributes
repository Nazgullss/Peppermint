# Normalise line endings. Development happens on Windows and deployment is on Linux, so
# anything the server executes must arrive with LF: a shell script checked out with CRLF
# fails on Linux with a "bad interpreter" error that reads as a missing file.

* text=auto

*.sh      text eol=lf
*.py      text eol=lf
*.conf    text eol=lf
*.service text eol=lf
Caddyfile text eol=lf

*.png binary
