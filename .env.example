# Every knob in the system, with its default. Copy to .env and edit, or set any of these
# in the environment -- nothing here requires a code change.
#
#   cp .env.example .env
#
# The three the challenge asks to be turned up (fleet size, update interval, payload size)
# are also settable at runtime on a running deployment, without a restart, through
# POST /api/admin/config. See README.md.

# ======================================================================================
# Simulator
# ======================================================================================

# The three knobs under test.
SIM_FLEET_SIZE=8
SIM_UPDATE_INTERVAL_MS=1000
SIM_PAYLOAD_PADDING_BYTES=0

# Robots per MQTT message. 1 is one message per robot, which is what a real fleet looks
# like on the wire. Larger values model an edge gateway aggregating for a group, and are
# roughly 15x cheaper per robot at high fleet sizes -- see notes/measurements.md.
SIM_PUBLISH_BATCH_SIZE=1

SIM_MQTT_HOST=localhost
SIM_MQTT_PORT=1883
# SIM_MQTT_USERNAME=fleet
# SIM_MQTT_PASSWORD=
SIM_TOPIC_PREFIX=fleet

# Fix the RNG for a reproducible fleet. Leave unset for a different fleet each run.
# SIM_SEED=42

# ======================================================================================
# Backend
# ======================================================================================

BACKEND_MQTT_HOST=localhost
BACKEND_MQTT_PORT=1883
# BACKEND_MQTT_USERNAME=fleet
# BACKEND_MQTT_PASSWORD=
BACKEND_TOPIC_PREFIX=fleet

# Frames pushed to each dashboard per second. Deliberately independent of how often
# robots publish: turning the simulator up does not increase browser render cost.
BACKEND_BROADCAST_HZ=5

# A full snapshot every N ticks, so a client that lost a delta self-heals without asking.
# At 5 Hz, 50 ticks is 10 seconds of worst-case staleness.
BACKEND_SNAPSHOT_EVERY_N_TICKS=50

# Frames buffered per dashboard. 1 means "only the newest frame matters": a slow client
# loses stale frames rather than building a backlog that would stall every other client.
BACKEND_CLIENT_QUEUE_SIZE=1

# Silence longer than this flags a robot as stale. Note that silence never *removes* a
# robot -- only an explicit lifecycle message does -- because a robot dying mid-task also
# goes silent and has to stay on the operator's screen.
BACKEND_STALE_AFTER_SECONDS=10

# Fleet-wide trend history kept in memory for the chart.
BACKEND_HISTORY_RETENTION_MINUTES=60

# Bearer token for POST /api/admin/config. Empty disables the live controls outright,
# which is safer than shipping a guessable default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_ADMIN_TOKEN=

# Browser origins allowed to call the API. In the deployed setup the backend serves the
# dashboard from its own origin, so this can be left empty there.
BACKEND_CORS_ORIGINS=http://localhost:5173
